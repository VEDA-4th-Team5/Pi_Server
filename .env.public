# pi-server 설정 전체 (민감정보 제외). 민감정보(API 키, 카메라 계정, RTSP)는
# .env.private 참고.
#
# 이 파일은 기존 6개 .env 파일(.env.example, .env.camera.local,
# .env.fire.local, .env.gemini.local, .env.iva.local, .env.log.local)을
# 합친 것이다. 같은 키가 여러 파일에 다른 값으로 있던 경우, 실제로 로컬에서
# 동작 중이던 .local 값을 채택했다 (아래 "운영 기본값과 다른 값" 참고).

# ---------------------------------------------------------------------------
# HTTP API (Qt 조회용)
# ---------------------------------------------------------------------------
# 원격 listener는 인증서와 키가 모두 필요하다. loopback 테스트만 HTTP를 허용한다.
HTTP_API_ENABLED=true
HTTP_LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTP_TLS_CERT_PATH=data/tls/server.crt
HTTP_TLS_KEY_PATH=data/tls/server.key
HTTP_DATA_ROOT=data
HTTP_MAX_IMAGE_MB=10
HTTP_REQUIRE_TLS=true

# Qt 앱 로그인/Bearer 인증
AUTH_SESSION_TTL_SECONDS=36000
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# DB / MQTT
# ---------------------------------------------------------------------------
EVENT_DB_PATH=data/db/parking.db
MQTT_HOST=localhost
MQTT_PORT=1883

# ---------------------------------------------------------------------------
# 카메라 (계정/RTSP는 .env.private)
# ---------------------------------------------------------------------------
CAMERA_ID=cam01
CAMERA_EVENT_SUB_TOPIC=+/onvif-ej/#

# ---------------------------------------------------------------------------
# 홀센서 / 주차 슬롯
# ---------------------------------------------------------------------------
# 실제 UART 연결 전 개발용 홀센서 MQTT 입력. 운영 기본값은 true이지만
# STM32 UART 링크(SENSOR_LINK_MODE=uart-line)를 실제로 쓰는 중이라 false.
HALL_MQTT_INPUT_ENABLED=false
HALL_MQTT_TOPIC=parking/sensor/hall
PARKING_SLOT_CONFIG=config/parking_slots.json
PARKING_HALL_ENABLED=true

# ---------------------------------------------------------------------------
# 센서 링크 (STM32/LoRa 직렬 입력). off | uart-line | lora-frame
# uart-line: SENSOR:HALL01:OCCUPIED:1\n 텍스트
# lora-frame: docs/UART_LORA_PROTOCOL.md의 CRC16 binary frame
# ---------------------------------------------------------------------------
#SENSOR_LINK_MODE=uart-line
#SENSOR_UART_DEVICE=/dev/ttyACM0
SENSOR_LINK_MODE=lora-frame
SENSOR_UART_DEVICE=/dev/serial0
SENSOR_UART_BAUD=115200
SENSOR_UART_READ_TIMEOUT_MS=250
SENSOR_UART_RECONNECT_MS=1000

# ---------------------------------------------------------------------------
# 화재 감지 (STM32 UART -> Pi -> MQTT)
# ---------------------------------------------------------------------------
# 홀센서 점유 경로와 같은 STM32 UART 링크(SENSOR_UART_* 재사용)를 공유한다.
FIRE_ALARM_ENABLED=true
FIRE_UART_DEVICE=/dev/ttyACM0
FIRE_UART_BAUD=115200
FIRE_UART_REOPEN_DELAY_MS=2000
# 화재 이벤트를 발행할 MQTT 토픽 접두사. 실제 토픽은 .../<channel_id>.
FIRE_TOPIC_PREFIX=parking/fire
# Qt가 화재 확인(ACK)을 발행하는 명령 토픽 접두사.
FIRE_COMMAND_TOPIC_PREFIX=parking/v1/commands/fire
# "화재센서ID=카메라채널ID" 매핑. 시연에서는 채널별 신호를 독립 처리한다.
FIRE_SENSOR_CHANNEL_MAP=FLAME01=ch01,FLAME02=ch02,FLAME03=ch03,FLAME04=ch04

# ---------------------------------------------------------------------------
# 야간 번호판 조명 LED. 예약된 촬영 직전에만 켜고 직후에 끈다.
# ---------------------------------------------------------------------------
PLATE_LED_ENABLED=true
# 일출/일몰 계산은 하지 않는다. 계절이 바뀌면 이 구간을 직접 조정한다.
PLATE_LED_NIGHT_START_HOUR=19
PLATE_LED_NIGHT_END_HOUR=7
# 점등 후 촬영까지 두는 정착 지연.
PLATE_LED_SETTLE_MS=2000

# ---------------------------------------------------------------------------
# 홀센서 점유 확정과 입차 후 MQTT 촬영 요청(T0+30초/60초)
# ---------------------------------------------------------------------------
# OCCUPIED 확정(T0) 유예시간(ms). 0이면 첫 OCCUPIED를 즉시 확정한다.
# HYBRID_OR 운영 기본값은 5000(5초).
PARKING_OCCUPANCY_CONFIRM_MS=5000
CAPTURE_SCHED_ENABLED=false
CAPTURE_TOPIC_PREFIX=parking/capture
CAPTURE_RESPONSE_TIMEOUT_MS=3000
CAPTURE_RETRY_INTERVAL_MS=2000
CAPTURE_MAX_RETRIES=2
# 실제 ROI 촬영→Gemini OCR 연결. 스케줄러가 꺼지면 시작 증거 OCR로 fallback한다.
HALL_CAPTURE_OCR_ENABLED=true
# 운영 기본 "30,60". 실기기 반복 시험에서는 "1,3"처럼 줄일 수 있다.
CAPTURE_OFFSETS_SEC=30,60
CAPTURE_OCR_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# CV5 cv_snapshot_api 기반 카메라 내부 화질 개선 촬영
# ---------------------------------------------------------------------------
CAMERA_SNAPSHOT_API_ENABLED=true
# CAMERA_OPEN_API_BASE 와 CAMERA_IMAGE_BASE 는 카메라 실제 주소가 들어가므로
# .env.private 에 둔다. 여기에 값을 적으면 .env.private 이 나중에 source 되어
# 덮어쓰긴 하지만, 굳이 두 곳에 나눠 적지 않는다.
CAMERA_IMAGE_SERVER_PORT=8080
CAMERA_SNAPSHOT_CONNECT_TIMEOUT_MS=3000
CAMERA_SNAPSHOT_REQUEST_TIMEOUT_MS=30000
CAMERA_SNAPSHOT_JPEG_TIMEOUT_MS=10000
CAMERA_SNAPSHOT_MAX_RETRIES=2
CAMERA_SNAPSHOT_RETRY_DELAY_MS=250
# API 실패 시 기존 RTSP+Pi 전처리로 돌아갈지 여부. 카메라 전처리만 쓰려면 false.
CAMERA_SNAPSHOT_API_RTSP_FALLBACK=false
# RTSP metadata Vehicle/Plate BestShot 경로. IVA+Snapshot API 운영에서는 중복이므로 끈다.
BESTSHOT_ENABLED=false
# 주차장 입구 BestShot 전용 경로. PNM-C16083RVQ의 실제 CH2 Metadata를
# ch02로 수신하고 기록한다. 카메라에서는 CH2의 입구 BestShot 규칙만 켠다.
ENTRANCE_ENABLED=true
ENTRANCE_CAMERA_ID=cam01
ENTRANCE_SOURCE_CHANNEL_ID=ch02
ENTRANCE_CHANNEL_ID=ch02
ENTRANCE_OUTPUT_ROOT=data/entrance
ENTRANCE_OBJECT_TTL_SECONDS=60
ENTRANCE_PENDING_CAPACITY=64
# 다른 ObjectId로 반복되는 같은 Plate BestShot을 EV/Gemini 전에 제거한다.
ENTRANCE_IMAGE_DEDUP_WINDOW_SECONDS=20
ENTRANCE_IMAGE_DEDUP_PHASH_THRESHOLD=10
# 정상 판정 이미지는 DB 결과 확정 후 삭제하고 실패 이미지만 24시간 보존한다.
ENTRANCE_DELETE_ARTIFACTS_ON_SUCCESS=true
ENTRANCE_FAILURE_RETENTION_HOURS=24
# 주차면 OCR은 최근 입구 OCR을 우선하며, 유일한 한 글자 차이만 자동 연결한다.
ENTRANCE_PLATE_MATCH_WINDOW_MINUTES=30
ENTRANCE_PLATE_MATCH_MIN_CONFIDENCE=0.85
# Plate BestShot의 아이콘 판정값을 VEHICLE.is_ev에 직접 반영한다.
ENTRANCE_EV_ANALYSIS_ENABLED=true
ENTRANCE_EV_PYTHON=/usr/bin/python3
ENTRANCE_EV_WORKER_SCRIPT=tools/cv/low_quality_presence_v1/runtime/pi_worker.py
ENTRANCE_EV_MODEL_BUNDLE=tools/cv/low_quality_presence_v1/model_bundle
ENTRANCE_EV_TEMPLATE_CACHE=tools/cv/low_quality_presence_v1/model_bundle/runtime_template_cache.json
ENTRANCE_EV_THRESHOLDS=tools/cv/low_quality_presence_v1/model_bundle/default_thresholds.json
ENTRANCE_EV_TIMEOUT_MS=5000
ENTRANCE_EV_QUEUE_CAPACITY=16
ENTRANCE_EV_OPENCV_THREADS=1
# 슬롯별 CV Snapshot API 0-based channel. CH1=0, CH3=2.
IVA_EV01_SNAPSHOT_API_CHANNEL=0
IVA_EV02_SNAPSHOT_API_CHANNEL=0
IVA_EV03_SNAPSHOT_API_CHANNEL=0
IVA_EV04_SNAPSHOT_API_CHANNEL=0
IVA_P01_SNAPSHOT_API_CHANNEL=2
IVA_P02_SNAPSHOT_API_CHANNEL=2
IVA_P03_SNAPSHOT_API_CHANNEL=2
IVA_P04_SNAPSHOT_API_CHANNEL=2

# ---------------------------------------------------------------------------
# IVA 연동 (EVDA-192/197)
# ---------------------------------------------------------------------------
# HALL, CAMERA_IVA 또는 HYBRID_OR. HYBRID_OR는 IVA Intrusion과 5초 확정된
# Hall OCCUPIED 중 먼저 도착한 입력으로 하나의 세션을 만들고 후속 입력은
# 같은 세션의 센서 확인 상태만 보강한다.
PARKING_OCCUPANCY_SOURCE=HYBRID_OR
# IVA 입출차는 카메라 ONVIF PullPoint의 실제 Intrusion/Exit Action을 사용한다.
# MQTT broker는 Hall/화재/Qt 및 기타 카메라 이벤트용으로 계속 실행한다.
CAMERA_IVA_EVENT_SOURCE=ONVIF
# CAMERA_IVA 모드에서 EXIT 후 출차를 확정하기 전 기다리는 시간(1~60초).
CAMERA_IVA_EXIT_CONFIRM_MS=10000
# WiseAI native IvaArea rule mapping. CH1=name1~4, CH3=name5~8.
IVA_EV01_AREA_NAME=name1
IVA_EV02_AREA_NAME=name2
IVA_EV03_AREA_NAME=name3
IVA_EV04_AREA_NAME=name4
IVA_P01_AREA_NAME=name1
IVA_P02_AREA_NAME=name2
IVA_P03_AREA_NAME=name3
IVA_P04_AREA_NAME=name4
IVA_P01_CHANNEL_ID=ch03
IVA_P02_CHANNEL_ID=ch03
IVA_P03_CHANNEL_ID=ch03
IVA_P04_CHANNEL_ID=ch03

# 슬롯 ROI 좌표는 일부러 비워 둔다. 네 값 중 하나라도 설정하면 AppConfig가
# roi_configured=true로 판정해서, Qt가 ROI 웹 도구로 SQLite에 저장해 둔 좌표
# 대신 이 파일의 값이 쓰인다. 환경변수로 고정하고 싶을 때만 주석을 푼다.
# IVA_EV01_ROI_X=0.0
# IVA_EV01_ROI_Y=0.0
# IVA_EV01_ROI_WIDTH=1.0
# IVA_EV01_ROI_HEIGHT=1.0

# ---------------------------------------------------------------------------
# pi-server 내부 EV 장기 점유 타이머
# ---------------------------------------------------------------------------
PARKING_TIMER_ENABLED=true
# 위반 판정과 장기점유 증거 촬영이 함께 사용하는 초기값 (REST 변경 후에는
# SQLite SYSTEM_SETTINGS 값이 우선한다). 운영 기본은 3600(1시간)이지만
# 현재 60초로 테스트 중.
PARKING_OVERSTAY_THRESHOLD_SECONDS=60
# 홀센서 비동기 작업은 같은 슬롯의 대기 이벤트를 최신 상태로 병합한다.
PARKING_HALL_WORK_QUEUE_CAPACITY=100

# ---------------------------------------------------------------------------
# Linux /dev/parking_alert 경고 상태 투영
# ---------------------------------------------------------------------------
PARKING_ALERT_DRIVER_ENABLED=true
PARKING_ALERT_DEVICE_PATH=/dev/parking_alert
# 일반 주차면 P01~P04는 EV 충전면 위반 경고 대상이 아니다.
PARKING_ALERT_SLOT_MAP=EV01:0,EV02:1,EV03:2,EV04:3

# ---------------------------------------------------------------------------
# Gemini OCR (키는 .env.private)
# ---------------------------------------------------------------------------
GEMINI_MODEL='gemini-3.1-flash-lite-preview'
GEMINI_FALLBACK_MODEL='gemini-3.1-flash-lite-preview'
PLATE_PREPROCESS_MODE='pipeline'
GEMINI_CONNECT_TIMEOUT_SEC='5'
GEMINI_REQUEST_TIMEOUT_SEC='30'

# ---------------------------------------------------------------------------
# Telegram 알림 (토큰과 채널은 .env.private)
# ---------------------------------------------------------------------------
# EVDA-189 기능이 병합된 빌드에서 사용한다. 현재 빌드가 해당 기능을 포함하지
# 않아도 환경변수로 미리 보존해 두는 것은 안전하다.
TELEGRAM_ENABLED=true
TELEGRAM_QUEUE_CAPACITY=256
TELEGRAM_CONNECT_TIMEOUT_MS=3000
TELEGRAM_REQUEST_TIMEOUT_MS=10000
TELEGRAM_RETRY_COUNT=2
TELEGRAM_RETRY_DELAY_MS=500

# ---------------------------------------------------------------------------
# 로그 켜고 끄기
# ---------------------------------------------------------------------------
# 심각도 하한. off | error | warn | info (기본 info)
LOG_LEVEL=info
# 아래에 명시되지 않은 태그의 기본값.
LOG_DEFAULT=true

# 심각도별 (태그 없는 로그)
LOG_INFO=true
LOG_WARN=true
LOG_ERROR=true

# 홀센서 / 주차 세션
LOG_HALL_SENSOR=false
LOG_HALL_CONFIRM=true
LOG_HALL_OCCUPIED=true
LOG_HALL_RECOVERY=true

# 화재
LOG_FIRE_ALARM=true

# 촬영 / 증거 이미지
LOG_EVIDENCE_CAPTURE=true
LOG_CAPTURE_SCHED=true

# OCR / 번호판
LOG_HALL_OCR=true
LOG_PLATE_PREPROCESS=true
LOG_PLATE_OCR=true
# Gemini 요청 1건당 실제 청구 토큰(usageMetadata). 이미지 수/바이트를 함께 남겨
# 토큰이 파일 크기가 아니라 해상도로 정해진다는 점을 로그에서 바로 대조할 수 있다.
LOG_GEMINI_USAGE=true

# 카메라 / BestShot
LOG_BESTSHOT=true
LOG_BESTSHOT_META=true
LOG_IVA_SNAPSHOT=true
LOG_PARKING_TRIGGER=true
LOG_CAMERA_EVENT=false

# 특수 (util/Logger를 거치지 않는 출력)
LOG_EVENT_JSON=true
LOG_EXIT_IGNORED=false
LOG_FFMPEG=false
