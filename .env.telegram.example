# Copy this file to .env.telegram.local and set the real bot token/channel.
# Never commit .env.telegram.local.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
TELEGRAM_CONNECT_TIMEOUT_MS=3000
TELEGRAM_REQUEST_TIMEOUT_MS=10000
TELEGRAM_RETRY_COUNT=2
TELEGRAM_RETRY_DELAY_MS=500
TELEGRAM_QUEUE_CAPACITY=256
