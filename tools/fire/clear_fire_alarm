#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CHANNEL_ID="${1:-ch01}"

if [[ ! "$CHANNEL_ID" =~ ^ch[0-9]{2}$ ]]; then
    echo "Invalid channel_id: $CHANNEL_ID (example: ch01)" >&2
    exit 2
fi

cd "$ROOT_DIR"
source "$ROOT_DIR/tools/load_env_file.sh"
load_env_file "$ROOT_DIR/.env.public"
load_env_file "$ROOT_DIR/.env.private"

if ! pgrep -x pi-server >/dev/null; then
    echo "pi-server is not running" >&2
    exit 1
fi
command -v mosquitto_pub >/dev/null 2>&1 || {
    echo "mosquitto_pub is required" >&2
    exit 1
}

MQTT_HOST="${MQTT_HOST:-localhost}"
MQTT_PORT="${MQTT_PORT:-1883}"
FIRE_COMMAND_TOPIC_PREFIX="${FIRE_COMMAND_TOPIC_PREFIX:-parking/v1/commands/fire}"

mosquitto_pub -h "$MQTT_HOST" -p "$MQTT_PORT" -q 1 \
    -t "$FIRE_COMMAND_TOPIC_PREFIX/$CHANNEL_ID" \
    -m "{\"command\":\"ALARM_CLEAR\",\"channel_id\":\"$CHANNEL_ID\"}"

echo "Fire clear requested: channel=$CHANNEL_ID"
