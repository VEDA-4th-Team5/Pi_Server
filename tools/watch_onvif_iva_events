#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_DIR="${PI_SERVER_ENV_DIR:-$ROOT_DIR}"
BUILD_DIR="${BUILD_DIR:-$ROOT_DIR/cmake-build}"

source "$ROOT_DIR/tools/load_env_file.sh"
load_env_file "$ENV_DIR/.env.public"
load_env_file "$ENV_DIR/.env.private"

if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ]]; then
    cmake -S "$ROOT_DIR" -B "$BUILD_DIR"
fi
cmake --build "$BUILD_DIR" --target watch-onvif-iva-events -j4

exec "$BUILD_DIR/watch-onvif-iva-events" "$@"
