PROJECT_NAME           = "VEDA Pi Server 코드 이해 가이드"
OUTPUT_DIRECTORY       = $(DOC_BUILD_DIR)/guide
INPUT                  = $(GENERATED_GUIDE_MD)
USE_MDFILE_AS_MAINPAGE = $(GENERATED_GUIDE_MD)
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = NO
HTML_DYNAMIC_MENUS     = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = NO
QUIET                  = YES
WARNINGS               = YES
WARN_LOGFILE           = $(DOC_BUILD_DIR)/guide-doxygen-warnings.log
