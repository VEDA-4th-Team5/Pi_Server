# 이 파일은 Git에서 제외됩니다(.gitignore). 화재 + 홀센서 점유 경로는 같은
# STM32 UART 링크(sensor_link, FIRE_UART_* 설정 재사용)를 공유하므로 이름은
# "fire"지만 홀/촬영 스케줄러 설정도 여기 같이 둔다.

SENSOR_LINK_MODE=uart-line
SENSOR_UART_DEVICE=/dev/ttyACM0
SENSOR_UART_BAUD=115200

# --- 화재 감지 (STM32 UART -> Pi -> MQTT) ---
FIRE_ALARM_ENABLED=true
# STM32와 연결된 UART 디바이스 경로. 홀센서(SENSOR:...)도 같은 포트로 들어온다.

FIRE_UART_BAUD=115200
FIRE_UART_DEVICE=/dev/ttyACM0
# 디바이스 open 실패/끊김 시 재시도 대기 시간(ms).
FIRE_UART_REOPEN_DELAY_MS=2000
# 화재 이벤트를 발행할 MQTT 토픽 접두사. 실제 토픽은 .../<slot_id>.
FIRE_TOPIC_PREFIX=parking/fire
# "화재센서ID=슬롯ID" 매핑. 콤마로 여러 개 이어쓸 수 있다(FLAME01=EV01,FLAME02=EV02).
FIRE_SENSOR_SLOT_MAP=FLAME01=EV01

# --- 홀센서 주차 점유 경로 (같은 STM32 UART 링크 공유, EVDA-134/136) ---
PARKING_HALL_ENABLED=true

# 홀센서 주차 제한시간
PARKING_TIMEOUT_SECONDS=60
# PARKING_TIMEOUT_SECONDS=3600 # 기본 3600초 = 1시간
PARKING_OVERSTAY_EVIDENCE_DELAY_SECONDS=60
# PARKING_OVERSTAY_EVIDENCE_DELAY_SECONDS=3600 # 기본 3600초 = 1시간


# 입차 후 T0+30s/60s 촬영 스케줄러(EVDA-135/136). false면 홀 세션은 열리지만
# 촬영 요청 자체가 안 나간다.
CAPTURE_SCHED_ENABLED=true

# OCCUPIED 확정(T0) 유예시간(ms). 0 = 첫 OCCUPIED 신호를 받자마자 즉시 T0로
# 확정한다. 실기기에서 점유/공백이 짧게 흔들리는(flapping) 걸 걸러내려면
# 10000(10초)처럼 켠다 -- 그만큼 세션 시작이 늦게 잡힌다.
# PARKING_OCCUPANCY_CONFIRM_MS=0
PARKING_OCCUPANCY_CONFIRM_MS=1000

# T0 이후 촬영 시점(초, 콤마 구분). 운영 기본값은 "30,60"(촬영 규약 값) --
# 이 값을 바꾼 채로 실기기/운영에 올리지 않는다.
# 지금 설정은 테스트용: 점유 확정 즉시(+1초)에 30초-단계 촬영/OCR 한 장만
# 실행하고 60초 재시도 단계는 건너뛴다. 재시도 정책(30초 실패 -> 60초 재시도)
# 까지 빠르게 확인하려면 아래 주석을 풀고 위 줄을 주석 처리한다.
CAPTURE_OFFSETS_SEC=1
# CAPTURE_OFFSETS_SEC=1,3
# CAPTURE_OFFSETS_SEC=30,60        # 운영/실기기 검증 시에는 이 값으로 되돌린다

# 시작 시 이전 실행이 못 닫은 ACTIVE 세션을 UNKNOWN으로 자동 정리할지.
# 기본 true(켜둔 채 두는 걸 권장) -- 재부팅 전 세션이 활성 슬롯 unique
# index를 계속 막아서, 꺼두면 같은 슬롯에서 다음 점유 신호가 새 세션을
# 못 연다. 재부팅 직후 DB 상태를 있는 그대로 들여다봐야 하는 실측/디버깅
# 세션에서만 잠깐 false로 끈다.
# RECOVER_STALE_SESSIONS_ON_START=false

HALL_MQTT_INPUT_ENABLED=false