# 이 파일은 예시/템플릿이다. 실제 값은 카메라 계정 전용 .env.camera.local,
# Gemini 키 전용 .env.gemini.local, 홀센서/화재 전용 .env.fire.local 처럼
# 자격증명 성격별로 분리된 .local 파일에 넣는다(.gitignore로 제외됨).
# 여기 있는 값은 커밋되므로 절대 실제 계정정보/키를 채우지 않는다.

# --- Qt 조회 API (I-10) ---
# true/false. HTTP_TLS_CERT_PATH/KEY_PATH를 둘 다 비우면 평문 HTTP로,
# 채우면 HTTPS로 뜬다.
HTTP_API_ENABLED=true
# 바인드 주소. 0.0.0.0 = 모든 네트워크 인터페이스에서 접속 허용.
HTTP_LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTP_TLS_CERT_PATH=
HTTP_TLS_KEY_PATH=
# 이미지 등 정적 파일을 서빙할 때 기준이 되는 루트 디렉터리.
HTTP_DATA_ROOT=data
# 한 번에 돌려줄 이미지 응답의 최대 크기(MB).
HTTP_MAX_IMAGE_MB=10

# --- 저장소 ---
# SQLite 파일 경로. 코드가 시작 시 없으면 새로 만든다.
EVENT_DB_PATH=data/db/parking.db

# --- MQTT (카메라/Qt 이벤트 브로커) ---
# Pi 위에서 도는 로컬 mosquitto를 그대로 쓴다.
MQTT_HOST=localhost
MQTT_PORT=1883

# --- 카메라/OCR 자격증명 (실제 값은 여기 X, .local 파일에만) ---
# rtsp://USER:PASSWORD@IP:554/... 형식. 계정정보 포함이라 저장소에 커밋 금지.
CAMERA_RTSP=
# Gemini OCR API 키. 커밋 금지.
GEMINI_API_KEY=
