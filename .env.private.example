# 이 파일을 .env.private 로 복사한 뒤 실제 값을 채우세요. (EVDA-203)
#
#   cp .env.private.example .env.private
#
# .env.private 는 .gitignore 대상이라 커밋되지 않습니다. 값은 팀 공유 채널에서
# 받아 넣고, Slack/메신저에 평문으로 남기지 마세요.
#
# 민감하지 않은 나머지 설정은 전부 .env.public 에 있고 Git으로 함께 배포됩니다.

# --- Gemini OCR ---
GEMINI_API_KEY=''

# --- 카메라 (RTSP URL 에 계정·비밀번호가 포함된다) ---
CAMERA_RTSP='rtsp://<USER>:<PASSWORD>@<CAMERA_IP>:554/profile2/media.smp'
CAMERA_API_USERNAME='<USER>'
CAMERA_API_PASSWORD='<PASSWORD>'

# --- 카메라 실제 주소 (CV Snapshot API) ---
CAMERA_OPEN_API_BASE='http://<CAMERA_IP>/opensdk/cv_snapshot_api'
CAMERA_IMAGE_BASE='http://<CAMERA_IP>:8080'
