# pi-server 로그 켜고 끄기.
#
# 이 파일(.env.log.local)은 .gitignore 대상이라 각자 로컬에서 직접 만들고
# 편한 대로 고쳐서 쓴다 (팀원 설정을 덮어쓰지 않음). 다른 .env.*.local 과
# 동일한 패턴 -- 공유용 템플릿(.example)은 따로 두지 않는다.
#
# 값은 true/false (1/0, on/off, yes/no 도 됨). 알아볼 수 없는 값을 쓰면
# 무시하고 기본값으로 동작한다 -- 오타 하나로 로그가 통째로 사라지지 않는다.
# 주석 처리하거나 지우면 그 항목은 기본값(대부분 true)이 된다.

# ---------------------------------------------------------------------------
# 전역 스위치
# ---------------------------------------------------------------------------

# 심각도 하한. off | error | warn | info (기본 info)
#   error = ERROR 만, warn = ERROR+WARN, info = 전부
# off 로 두면 아래 LOG_* 를 뭘 켜든 아무것도 안 나온다.
LOG_LEVEL=info

# 아래에 명시되지 않은 태그의 기본값. false 로 두면 "필요한 것만 켜는" 방식이
# 된다. WARN/ERROR/INFO 는 이 값의 영향을 받지 않는다(사고 나면 봐야 하므로).
LOG_DEFAULT=true

# ---------------------------------------------------------------------------
# 심각도별 (태그 없는 로그)
# ---------------------------------------------------------------------------

# [INFO] 기동/설정/연결 상태. "pi-server started", "MQTT connected" 등
LOG_INFO=true
# [WARN] 거부된 센서 프레임, 재시도 등
LOG_WARN=true
# [ERROR] 발행 실패, DB 오류 등. 웬만하면 끄지 말 것
LOG_ERROR=true

# ---------------------------------------------------------------------------
# 홀센서 / 주차 세션
# ---------------------------------------------------------------------------

# [HALL_SENSOR] 매 수신 프레임의 무시/대기 판정.
#   STM32 가 1초마다 같은 상태를 보내므로 로그의 대부분이 이것이다.
#   ("event ignored: slot=EV01 reason=slot is already occupied")
LOG_HALL_SENSOR=false

# [HALL_CONFIRM] 점유 확정(T0) 시점
LOG_HALL_CONFIRM=true
# [HALL_OCCUPIED] 입차 세션 생성 + 증거 촬영 예약
LOG_HALL_OCCUPIED=true
# [HALL_RECOVERY] 재시작 후 DB 에 남아있던 ACTIVE 세션 인수
LOG_HALL_RECOVERY=true

# ---------------------------------------------------------------------------
# 화재
# ---------------------------------------------------------------------------

# [FIRE_ALARM] 화재 후보 SUSPECTED/CLEARED 와 발행 토픽
LOG_FIRE_ALARM=true

# ---------------------------------------------------------------------------
# 촬영 / 증거 이미지
# ---------------------------------------------------------------------------

# [EVIDENCE_CAPTURE] 입차/장기점유 증거 촬영 예약·성공·취소
LOG_EVIDENCE_CAPTURE=true
# [CAPTURE_SCHED] T0+30s/60s 촬영 스케줄러
LOG_CAPTURE_SCHED=true

# ---------------------------------------------------------------------------
# OCR / 번호판
# ---------------------------------------------------------------------------

# [HALL_OCR] 세션 바인딩, 촬영 단계 진행, 최종 판독 성공/실패
LOG_HALL_OCR=true
# [PLATE_PREPROCESS] 원본 -> enhanced 이미지 생성 경로
LOG_PLATE_PREPROCESS=true
# [PLATE_OCR] Gemini 판독 결과(번호판, 분류)
LOG_PLATE_OCR=true

# ---------------------------------------------------------------------------
# 카메라 / BestShot
# ---------------------------------------------------------------------------

# [BESTSHOT] BestShot 차량·번호판 이미지 저장
LOG_BESTSHOT=true
# [BESTSHOT_META] BestShot 메타데이터 수신/억제
LOG_BESTSHOT_META=true
# [IVA_SNAPSHOT] IVA 영역 스냅샷 저장
LOG_IVA_SNAPSHOT=true
# [PARKING_TRIGGER] IVA <-> BestShot 상관관계 매칭
LOG_PARKING_TRIGGER=true

# [CAMERA_EVENT] IVA 가 아닌 카메라 이벤트를 버렸다는 기록.
#   Motion/ObjectDetection 이 IVA 와 동시에 쏟아져서 꽤 시끄럽다.
LOG_CAMERA_EVENT=false

# ---------------------------------------------------------------------------
# 특수 (util/Logger 를 거치지 않는 출력)
# ---------------------------------------------------------------------------

# 표준출력으로 나가는 한 줄 JSON 이벤트.
#   {"event_type":"SLOT_OCCUPIED","slot_id":"EV01",...}
#   이건 화면 표시용이다. false 로 꺼도 Qt 로 가는 MQTT 발행은 그대로 동작한다.
LOG_EVENT_JSON=true

# [EXIT_IGNORED] 빈 슬롯이 VACANT를 재전송할 때마다(초당) "no active session"
#   이 찍힌다. LOG_EVENT_JSON=true 여도 이것만 따로 끌 수 있다.
#   (MQTT 발행 자체는 이 스위치와 무관하게 그대로 나간다.)
LOG_EXIT_IGNORED=false

# FFmpeg/OpenCV 가 직접 stderr 로 뱉는 디코더 경고.
#   "[h264 @ 0x...] mmco: unref short failure"
#   "[mjpeg @ 0x...] Picture size 0x1520 is invalid"
#   손상 프레임마다 나와서 실제 로그를 덮어버린다.
#   false 면 libavutil 로그를 AV_LOG_QUIET 으로 막는다.
LOG_FFMPEG=false
